<?xml version="1.0" encoding="utf-8"?>
<!-- 网络安全配置：允许 HTTP 明文流量访问生产服务器 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">139.196.175.70</domain>
    </domain-config>
    <!-- 允许调试时使用 localhost -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
